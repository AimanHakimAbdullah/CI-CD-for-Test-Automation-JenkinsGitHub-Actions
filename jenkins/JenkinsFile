pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building...'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing...'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying...'
            }
        }

        stage('Unit Test - Backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            environment {
                GOCACHE = '/tmp/.cache/go-build'
                GOPATH = '/tmp/go'
            }
            steps {
                dir('bugtracker-backend') {
                    sh "go test -v ./..."
                }   
            }
        }

        stage('Unit Test - Frontend') {
            agent {
                docker {
                    image 'node:20'
                    reuseNode true
                }
            }
            environment {
                HOME = '/tmp'
                npm_config_cache = '/tmp/.npm'
            }
            steps {
                dir('bugtracker-frontend') {
                    sh "npm ci"
                    sh "npm test"
                }   
            }
        }   
    }
}