pipeline {
    agent any

    stages {
        // Backend and frontend unit tests are independent, so run them side by side
        stage('Execute Unit Tests') {
            parallel {
                stage('Unit Test - Backend') {
                    // Run inside a Go container; reuseNode keeps the same workspace as the host agent
                    agent {
                        docker {
                            image 'snakee/golang-junit:1.21'
                            reuseNode true
                        }
                    }
                    // Point Go caches at /tmp because the container user cannot write to the default location
                    environment {
                        GOCACHE = '/tmp/.cache/go-build'
                        GOPATH = '/tmp/go'
                    }
                    steps {
                        dir('bugtracker-backend') {
                            sh '''
                                mkdir -p reports

                                # Capture the exit code so reports are still generated when tests fail
                                go test -v -coverprofile=coverage.out ./... > test.log 2>&1; status=$?
                                cat test.log
                                # Convert go test output to JUnit XML for Jenkins
                                go-junit-report < test.log > reports/report.xml

                                # Render the coverage profile as an HTML report
                                go tool cover -html=coverage.out -o reports/coverage.html

                                # Fail the stage with the original test result
                                exit $status
                            '''
                        }
                    }
                    // Publish results even if the tests failed
                    post {
                        always {
                            junit 'bugtracker-backend/reports/report.xml'
                            publishHTML(target: [
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'bugtracker-backend/reports',
                                reportFiles: 'coverage.html',
                                reportName: 'Backend Coverage Report'
                            ])
                            archiveArtifacts artifacts: 'bugtracker-backend/reports/coverage.html', fingerprint: true
                        }
                    }
                }

                stage('Unit Test - Frontend') {
                    // Run inside a Node container; reuseNode keeps the same workspace as the host agent
                    agent {
                        docker {
                            image 'node:20'
                            reuseNode true
                        }
                    }
                    // Give npm a writable HOME and cache since the container user has no home directory
                    environment {
                        HOME = '/tmp'
                        npm_config_cache = '/tmp/.npm'
                    }
                    steps {
                        dir('bugtracker-frontend') {
                            sh '''
                                # Clean, reproducible install from package-lock.json
                                npm ci

                                # Capture the exit code so reports are still collected when tests fail
                                npm test; status=$?

                                # Move JUnit and coverage output into a fresh reports/ for publishing
                                # (clear it first so a leftover reports/coverage from an earlier build doesn't break mv)
                                rm -rf reports
                                mkdir -p reports
                                mv test-results.xml reports/test-results.xml
                                mv coverage reports/coverage

                                # Fail the stage with the original test result
                                exit $status
                            '''
                        }
                    }
                    // Publish results even if the tests failed
                    post {
                        always {
                            junit 'bugtracker-frontend/reports/test-results.xml'
                            publishHTML(target: [
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'bugtracker-frontend/reports/coverage',
                                reportFiles: 'index.html',
                                reportName: 'Frontend Coverage Report'
                            ])
                            archiveArtifacts artifacts: 'bugtracker-frontend/reports/coverage/index.html', fingerprint: true
                        }

                    }
                }
            }
        }

        stage('Launch Application') {
            agent {
                docker {
                    image 'docker:27.5.1'
                    reuseNode true
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }
            steps {
                sh 'docker compose up --build -d'
            }
        }

        stage('API Tests') {
            // Playwright image version matches @playwright/test in tests-api/package-lock.json
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    // host network so localhost:8080 reaches the backend published by compose
                    args '--network host'
                }
            }
            environment {
                HOME = '/tmp'
                npm_config_cache = '/tmp/.npm'
            }
            steps {
                dir('tests-api') {
                    sh '''
                        npm ci

                        # up -d returns before the app is ready, so wait for the backend port
                        npx wait-port -t 60000 localhost:8080

                        # Capture the exit code so reports are still published when tests fail
                        npx playwright test; status=$?
                        exit $status
                    '''
                }
            }
            // Publish results even if the tests failed
            post {
                always {
                    junit 'tests-api/test-results/results.xml'
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'tests-api/playwright-report',
                        reportFiles: 'index.html',
                        reportName: 'API Test Report'
                    ])
                }
            }
        }

        stage('E2E Test'){
            agent {
                docker{
                    image 'mcr.microsoft.com/playwright:v1.50.0-noble'
                    reuseNode true
                    args '--network host'
                }
            }

                steps{
                    dir('tests-e2e'){
                        sh '''
                        npm ci

                        npx playwright test
                        '''
                    }
                }

                post {
                    always {
                        junit 'tests-e2e/test-results/results.xml'
                        publishHTML(target: [
                            allowMissing: false,
                            alwaysLinkToLastBuild: true,
                            keepAll: true,
                            reportDir: 'tests-e2e/playwright-report',
                            reportFiles: 'index.html',
                            reportName: 'E2E Test Report'
                        ])
                    }
                }
        }
        
    }

    post {
        always {
            sh 'docker compose down'
            cleanWs()
        }
    }
}